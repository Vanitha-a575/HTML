<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Online Quiz System</title>

<style>
body{
    font-family: Arial, sans-serif;
    background: linear-gradient(to right,#4facfe,#00f2fe);
    margin:0;
}

.container{
    width:70%;
    margin:auto;
    margin-top:40px;
    background:white;
    padding:25px;
    border-radius:12px;
    box-shadow:0 0 15px gray;
}

h1,h2{
    text-align:center;
    color:#0d47a1;
}

input{
    width:95%;
    padding:10px;
    margin:10px 0;
}

button{
    background:#1565c0;
    color:white;
    border:none;
    padding:10px 20px;
    border-radius:6px;
    cursor:pointer;
    font-size:16px;
}

button:hover{
    background:#0d47a1;
}

.question{
    margin-bottom:20px;
    padding:15px;
    background:#f5f5f5;
    border-radius:10px;
}

#quizPage{
    display:none;
}

#result{
    text-align:center;
    font-size:22px;
    color:green;
    font-weight:bold;
}
</style>

<script>

function login(){
    var name=document.getElementById("name").value;
    var pass=document.getElementById("pass").value;

    if(name=="" || pass==""){
        alert("Please Enter Username and Password");
        return;
    }

    document.getElementById("loginPage").style.display="none";
    document.getElementById("quizPage").style.display="block";
    document.getElementById("student").innerHTML=name;
}

function submitQuiz(){

var score=0;

if(document.querySelector('input[name="q1"]:checked')?.value=="b") score++;
if(document.querySelector('input[name="q2"]:checked')?.value=="a") score++;
if(document.querySelector('input[name="q3"]:checked')?.value=="c") score++;
if(document.querySelector('input[name="q4"]:checked')?.value=="d") score++;
if(document.querySelector('input[name="q5"]:checked')?.value=="b") score++;
if(document.querySelector('input[name="q6"]:checked')?.value=="c") score++;
if(document.querySelector('input[name="q7"]:checked')?.value=="a") score++;
if(document.querySelector('input[name="q8"]:checked')?.value=="d") score++;
if(document.querySelector('input[name="q9"]:checked')?.value=="b") score++;
if(document.querySelector('input[name="q10"]:checked')?.value=="c") score++;

document.getElementById("result").innerHTML=
"🎉 Your Score : "+score+" / 10";

}

function restartQuiz(){
location.reload();
}

</script>

</head>

<body>

<div class="container" id="loginPage">

<h1>ONLINE QUIZ SYSTEM</h1>

<h2>Student Login</h2>

<input type="text" id="name" placeholder="Enter Username">

<input type="password" id="pass" placeholder="Enter Password">

<center>
<button onclick="login()">Login</button>
</center>

</div>

<div class="container" id="quizPage">

<h2>Welcome <span id="student"></span></h2>

<form>

<div class="question">
<b>1. HTML stands for?</b><br>
<input type="radio" name="q1" value="a">Hyper Trainer Marking Language<br>
<input type="radio" name="q1" value="b">Hyper Text Markup Language<br>
<input type="radio" name="q1" value="c">High Text Machine Language<br>
<input type="radio" name="q1" value="d">Home Tool Markup Language
</div>

<div class="question">
<b>2. JavaScript is a ______?</b><br>
<input type="radio" name="q2" value="a">Programming Language<br>
<input type="radio" name="q2" value="b">Database<br>
<input type="radio" name="q2" value="c">Browser<br>
<input type="radio" name="q2" value="d">Server
</div>

<div class="question">
<b>3. CSS is used for?</b><br>
<input type="radio" name="q3" value="a">Database<br>
<input type="radio" name="q3" value="b">Programming<br>
<input type="radio" name="q3" value="c">Styling Web Pages<br>
<input type="radio" name="q3" value="d">Networking
</div>

<div class="question">
<b>4. Which tag inserts an image?</b><br>
<input type="radio" name="q4" value="a">&lt;image&gt;<br>
<input type="radio" name="q4" value="b">&lt;picture&gt;<br>
<input type="radio" name="q4" value="c">&lt;photo&gt;<br>
<input type="radio" name="q4" value="d">&lt;img&gt;
</div>

<div class="question">
<b>5. Which company developed Java?</b><br>
<input type="radio" name="q5" value="a">Google<br>
<input type="radio" name="q5" value="b">Sun Microsystems<br>
<input type="radio" name="q5" value="c">Microsoft<br>
<input type="radio" name="q5" value="d">Apple
</div>

<div class="question">
<b>6. Which is not a programming language?</b><br>
<input type="radio" name="q6" value="a">Python<br>
<input type="radio" name="q6" value="b">Java<br>
<input type="radio" name="q6" value="c">HTML<br>
<input type="radio" name="q6" value="d">C++
</div>

<div class="question">
<b>7. Which symbol is used for ID selector in CSS?</b><br>
<input type="radio" name="q7" value="a">#<br>
<input type="radio" name="q7" value="b">.<br>
<input type="radio" name="q7" value="c">*</br>
<input type="radio" name="q7" value="d">@
</div>

<div class="question">
<b>8. Which HTML tag creates a hyperlink?</b><br>
<input type="radio" name="q8" value="a">&lt;link&gt;<br>
<input type="radio" name="q8" value="b">&lt;url&gt;<br>
<input type="radio" name="q8" value="c">&lt;href&gt;<br>
<input type="radio" name="q8" value="d">&lt;a&gt;
</div>

<div class="question">
<b>9. Which keyword declares a variable in JavaScript?</b><br>
<input type="radio" name="q9" value="a">int<br>
<input type="radio" name="q9" value="b">var<br>
<input type="radio" name="q9" value="c">string<br>
<input type="radio" name="q9" value="d">float
</div>

<div class="question">
<b>10. Which tag creates a table row?</b><br>
<input type="radio" name="q10" value="a">&lt;td&gt;<br>
<input type="radio" name="q10" value="b">&lt;th&gt;<br>
<input type="radio" name="q10" value="c">&lt;tr&gt;<br>
<input type="radio" name="q10" value="d">&lt;table&gt;
</div>

<center>
<button type="button" onclick="submitQuiz()">Submit Quiz</button>
<button type="button" onclick="restartQuiz()">Restart</button>
</center>

</form>

<p id="result"></p>

</div>

</body>
</html>
