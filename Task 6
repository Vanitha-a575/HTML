<!DOCTYPE html>
<html>
<head>
    <title>Student Registration Form</title>
</head>

<body>

<center>
    <h1>STUDENT REGISTRATION FORM</h1>
    <h3>Create your account and join with us!</h3>
</center>

<form>

<h3>1. Personal Information</h3>

<table cellpadding="8">

<tr>
    <td>Full Name</td>
    <td>:</td>
    <td><input type="text" name="fullname" size="35"></td>
</tr>

<tr>
    <td>Email Address</td>
    <td>:</td>
    <td><input type="email" name="email" size="35"></td>
</tr>

<tr>
    <td>Mobile Number</td>
    <td>:</td>
    <td><input type="text" name="mobile" size="35"></td>
</tr>

<tr>
    <td>Date of Birth</td>
    <td>:</td>
    <td><input type="date" name="dob"></td>
</tr>

<tr>
    <td>Gender</td>
    <td>:</td>
    <td>
        <input type="radio" name="gender"> Male
        <input type="radio" name="gender"> Female
        <input type="radio" name="gender"> Other
    </td>
</tr>

<tr>
    <td>Address</td>
    <td>:</td>
    <td><textarea rows="4" cols="40"></textarea></td>
</tr>

</table>

<hr>

<h3>2. Education Details</h3>

<table cellpadding="8">

<tr>
    <td>Course</td>
    <td>:</td>
    <td>
        <input type="checkbox"> B.Sc CS
        <input type="checkbox"> BCA
        <input type="checkbox"> B.Com
        <input type="checkbox"> BBA
        <input type="checkbox"> MCA
    </td>
</tr>

<tr>
    <td>Year of Study</td>
    <td>:</td>
    <td>
        <input type="radio" name="year"> I Year
        <input type="radio" name="year"> II Year
        <input type="radio" name="year"> III Year
    </td>
</tr>

<tr>
    <td>Department</td>
    <td>:</td>
    <td>
        <select>
            <option>--Select Department--</option>
            <option>Computer Science</option>
            <option>Information Technology</option>
            <option>Commerce</option>
            <option>Management</option>
        </select>
    </td>
</tr>

</table>

<hr>

