<!DOCTYPE html>
<html>
<head>
    <title>Tech Product Landing Page</title>

    <script>
        function welcome() {
            alert("Welcome to Tech Product Landing Page!");
        }

        function buyNow() {
            var name = prompt("Enter your Name:");

            if (name != "") {
                var result = confirm("Do you want to purchase this product?");

                if (result == true) {
                    alert("Thank You " + name + "! Your order has been placed.");
                }
                else {
                    alert("Purchase Cancelled.");
                }
            }
        }
    </script>
</head>

<body onload="welcome()">

<center>
    <h1>TECH PRODUCT LANDING PAGE</h1>
    <h3>Latest Gadgets at Affordable Prices</h3>
    <hr>

    <a href="#home">Home</a> |
    <a href="#products">Products</a> |
    <a href="#gallery">Gallery</a> |
    <a href="#contact">Contact</a>

    <hr>
</center>

<h2 id="home">Home</h2>

<p>
Welcome to our Tech Product Store. We offer high-quality laptops,
smartphones, headphones, smart watches, and accessories at affordable prices.
</p>

<img src="laptop.jpg" width="300" height="200">

